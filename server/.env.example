# Create at Garmin Connect → Personal API Key (shown only once).
# https://developer.garmin.com/gc-developer-program/overview/
GARMIN_PERSONAL_API_KEY=

PORT=4000

# Redis is the primary cache store.
# If Redis is unreachable, the API automatically falls back to in-memory cache.
REDIS_URL=redis://127.0.0.1:6379
GARMIN_CACHE_TTL_SEC=900
GARMIN_DETAIL_CACHE_TTL_SEC=3600
